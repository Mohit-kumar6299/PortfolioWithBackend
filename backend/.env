# Server
PORT=5000
CORS_ORIGIN=http://localhost:5173

# SMTP (used to email you when someone submits the contact form)
# For Gmail: enable 2FA on the account, then create an "App Password"
# at https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Address that receives contact-form emails
CONTACT_RECEIVER=mohitkumar629961@gmail.com

# Secret key required to view stored messages at GET /api/contact
# Send it as header:  x-admin-key: <this value>
ADMIN_API_KEY=change-this-to-a-long-random-string
